# Copy this file to .env and add your key.
# Get a free Google Gemini API key at https://ai.google.dev/
# Without a key the app still runs, in demo mode (pre-written sample narratives).
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: which Gemini model to use (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
