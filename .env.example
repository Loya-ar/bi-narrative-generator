# Copy this file to .env and add your key.
# Get a free Gemini API key at https://aistudio.google.com/apikey (use a project with no billing linked, so it can never charge)
# Without a key the app still runs, in demo mode (pre-written sample narratives).
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: which Gemini model to use (default: gemini-3.5-flash-lite, free tier)
# GEMINI_MODEL=gemini-3.5-flash-lite
